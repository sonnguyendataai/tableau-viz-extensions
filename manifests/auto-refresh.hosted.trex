<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <!-- Bản HOSTED (HTTPS) cho Tableau Cloud/Server.
       KHÁC bản localhost DUY NHẤT ở <url>. Giữ NGUYÊN id để không mất settings.
       Tableau Server on-prem: trỏ <url> về web server tĩnh nội bộ (xem docs/05-deploy-onprem.md)
       và allow-list domain đó. -->
  <dashboard-extension id="com.sonnguyen.vizplatform.autorefresh" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Tự refresh data source của dashboard theo chu kỳ cấu hình được (tối thiểu 10s).</description>
    <author name="son.nguyen" email="son.nguyen@corp.local" organization="Tableau Viz Platform" website="https://viz.corp.local"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://sonnguyendataai.github.io/tableau-viz-extensions/src/dashboard-extensions/auto-refresh/auto-refresh.html</url>
    </source-location>
    <icon/>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Auto Refresh (Platform)</text>
    </resource>
  </resources>
</manifest>
