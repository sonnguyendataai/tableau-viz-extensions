<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <!-- DASHBOARD extension. Add to a dashboard: drag an "Extension" object → Access Local Extensions → this file.
       Dev server: npm start (repo root, port 8765). For Tableau Server on-prem, copy this file, point <url> at the
       internal HTTPS web server and allow-list that domain (docs/05-deploy-onprem.md). -->
  <dashboard-extension id="com.sonnguyen.vizplatform.realtimekpi" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Cập nhật định kỳ CHỈ các nguồn dữ liệu được chọn (chỉ tiêu realtime), mỗi nguồn một chu kỳ riêng.</description>
    <author name="son.nguyen" email="son.nguyen@corp.local" organization="Tableau Viz Platform" website="https://viz.corp.local"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8765/src/dashboard-extensions/realtime-kpi/realtime-kpi.html</url>
    </source-location>
    <icon/>
    <!-- getDataSourcesAsync needs full data. -->
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Realtime KPI (BIDV POC)</text>
    </resource>
  </resources>
</manifest>
