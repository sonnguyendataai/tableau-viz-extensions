<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <!-- DASHBOARD extension (khác các viz trong src/vizzes/ là worksheet-extension).
       Thêm vào dashboard: kéo object "Extension" từ panel Objects → Access Local Extensions. -->
  <dashboard-extension id="com.sonnguyen.vizplatform.autorefresh" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Tự refresh data source của dashboard theo chu kỳ cấu hình được (tối thiểu 10s).</description>
    <author name="son.nguyen" email="son.nguyen@corp.local" organization="Tableau Viz Platform" website="https://viz.corp.local"/>
    <min-api-version>1.11</min-api-version>
    <!-- URL localhost phải KHỚP CHÍNH XÁC đường dẫn dev server phục vụ.
         npm start (http-server tại repo root, cổng 8765) → path này. -->
    <source-location>
      <url>http://localhost:8765/src/dashboard-extensions/auto-refresh/auto-refresh.html</url>
    </source-location>
    <icon/>
    <!-- getDataSourcesAsync cần full data. -->
    <permissions>
      <permission>full data</permission>
    </permissions>
    <!-- Configure... trên menu zone → mở auto-refresh-config.html. -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Auto Refresh (Platform)</text>
    </resource>
  </resources>
</manifest>
